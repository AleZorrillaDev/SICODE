/* --- AUTODOC MODULE CSS (DiseÃ±o Fusionado BPSearch + DocCheck) --- */

:root {
  /* Palette from BPSearch & DocCheck */
  --primary-blue: #0066b3;
  --primary-hover: #005494;
  --accent-pink: #a91e5c;  /* BPSearch Style */
  --accent-red: #ae0d41;   /* DocCheck Action Style */
  --bg-page: #d8e3f0;      /* BPSearch Background */
  --card-bg: #ffffff;
  --text-main: #333333;
  --text-muted: #666666;
  --border-light: #e0e0e0;
  
  /* DocCheck Entry Box Colors */
  --label-bg: #0163ac;
  --label-text: #ffffff;
  
  /* Spacing & Radius */
  --radius-pill: 100px;
  --radius-card: 20px;
  --shadow-soft: 0 4px 12px rgba(0, 0, 0, 0.1);
  --shadow-hover: 0 8px 20px rgba(0, 0, 0, 0.15);
  --font-family: 'Poppins', sans-serif;
}

/* Base Reset & Fonts within wrapper */
.autodoc-wrapper {
  font-family: var(--font-family);
  background-color: var(--bg-page);
  min-height: calc(100vh - 70px);
  padding: 25px 40px 40px;
  color: var(--text-main);
  box-sizing: border-box;
}

.autodoc-wrapper * {
  box-sizing: border-box;
}

/* --- HEADER / TOOLBAR (DocCheck Style) --- */
.autodoc-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 20px;
  margin-bottom: 30px;
  background: transparent; /* Clean look like BPSearch page header */
}

.header-left h1 {
  font-size: 24px;
  font-weight: 700;
  color: var(--primary-blue);
  margin: 0;
}

.header-left p {
  color: var(--text-muted);
  font-size: 14px;
  margin-top: 4px;
}

.header-actions {
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
}

/* --- BUTTONS (Pill Shape) --- */
.autodoc-wrapper .btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 24px;
  border-radius: var(--radius-pill);
  border: none;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: 0 4px 6px rgba(0,0,0,0.1);
  text-decoration: none;
  color: white;
}

.autodoc-wrapper .btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(0,0,0,0.15);
}

.btn-primary {
  background-color: var(--primary-blue);
}
.btn-primary:hover {
  background-color: var(--primary-hover);
}

.btn-secondary {
  background-color: white;
  color: var(--primary-blue) !important;
  border: 2px solid var(--primary-blue) !important;
}
.btn-secondary:hover {
  background-color: #f0f8ff;
}

.btn-primary-alt {
  background-color: var(--accent-pink);
}
.btn-primary-alt:hover {
  background-color: #8a1849;
}

.btn-success {
  background-color: #2d8e5f;
}
.btn-success:hover {
  background-color: #1e6b45;
}

.btn-danger {
  background-color: white;
  color: var(--accent-red) !important;
  border: 1px solid var(--accent-red) !important;
  padding: 8px 16px;
  box-shadow: none !important;
}
.btn-danger:hover {
  background-color: #fff5f5;
}

/* --- CARDS (Rounded BPSearch Style) --- */
.document-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.card {
  background-color: var(--card-bg);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-soft);
  border: none; /* Removed heavy border */
  transition: all 0.3s ease;
  overflow: hidden;
  position: relative;
}

.card:hover {
  box-shadow: var(--shadow-hover);
}

.card.expanded {
  box-shadow: 0 8px 25px rgba(0,0,0,0.2);
  transform: scale(1.005);
  border-left: 5px solid var(--primary-blue);
}

.card-header {
  padding: 20px 30px;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
}

.card-header-content {
  display: flex;
  align-items: center;
  gap: 20px;
  flex: 1;
  flex-wrap: wrap;
}

.card-number {
  width: 40px;
  height: 40px;
  background: var(--bg-page);
  color: var(--primary-blue);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 16px;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 15px;
}

.info-item label {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  color: var(--text-muted);
  text-transform: uppercase;
  font-weight: 600;
  margin-bottom: 2px;
}

.info-item div {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.info-item div.empty {
  color: #aaa;
  font-style: italic;
}

.status-badge {
  padding: 4px 12px;
  border-radius: var(--radius-pill);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
}
.status-badge.pending {
  background-color: #f1f5f9;
  color: var(--text-muted);
}
.status-badge.completed {
  background-color: #dcfce7;
  color: #166534;
}

.card-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.btn-icon-round {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: none;
  background: #f0f4f8;
  color: var(--primary-blue);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s;
}
.btn-icon-round:hover {
  background: var(--primary-blue);
  color: white;
}

/* --- CARD BODY (Expandable) --- */
.card-body {
  padding: 0 30px 30px;
  border-top: 1px solid var(--border-light);
  background-color: #fafbfc; /* Slight contrast for edit area */
  animation: slideDown 0.3s ease-out;
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* --- TABS --- */
.tabs {
  display: flex;
  gap: 10px;
  padding: 20px 0;
  overflow-x: auto;
  border-bottom: 1px solid var(--border-light);
  margin-bottom: 20px;
}

.tab-btn {
  padding: 8px 20px;
  border-radius: var(--radius-pill);
  font-size: 13px;
  font-weight: 600;
  white-space: nowrap;
  border: 2px solid transparent; /* Invisible border to prevent layout shift */
  background: transparent;
  color: var(--text-muted);
  cursor: pointer;
  transition: all 0.2s;
}

.tab-btn:hover {
  color: var(--primary-blue);
  background: #eef6fc;
}

.tab-btn.active {
  background: white;
  color: var(--primary-blue);
  border-color: var(--primary-blue);
  box-shadow: 0 2px 5px rgba(0,0,0,0.05);
}

.tab-content.active {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
}

/* --- INPUTS (DocCheck Capsule Style) --- */
.form-group {
    flex: 1;
    min-width: 280px; /* Responsive breakpoints */
}

/* Contenedor principal del input (CÃ¡psula blanca) */
.entry-box {
    display: flex;
    align-items: center;
    background-color: white;
    border-radius: var(--radius-pill);
    height: 48px;
    padding: 4px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
    border: 1px solid var(--border-light);
    width: 100%;
    transition: border-color 0.2s;
}

.entry-box:focus-within {
    border-color: var(--primary-blue);
    box-shadow: 0 0 0 3px rgba(0, 102, 179, 0.1);
}

/* Etiqueta azul interna */
.entry-label {
    display: flex;
    min-width: 120px; /* Ancho fijo para alineaciÃ³n vertical limpia */
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: var(--label-bg);
    border-radius: var(--radius-pill);
    color: var(--label-text);
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    padding: 0 15px;
    white-space: nowrap;
    user-select: none;
}

/* Input real transparente */
.entry-input, .entry-select {
    flex: 1;
    border: none;
    height: 100%;
    background: transparent;
    font-family: var(--font-family);
    font-size: 14px;
    color: var(--text-main);
    padding-left: 15px;
    outline: none;
    border-radius: 0 var(--radius-pill) var(--radius-pill) 0;
    font-weight: 500;
    width: 100%; /* Fix for select */
}

.entry-select {
    cursor: pointer;
}

.entry-input::placeholder {
    color: #999;
}

/* Textarea needs special handling */
.form-group-textarea .entry-box {
    height: auto;
    border-radius: 20px;
    flex-direction: column;
    align-items: stretch;
    padding: 10px;
}
.form-group-textarea .entry-label {
    height: 30px;
    width: 100%;
    margin-bottom: 5px;
}
.form-group-textarea textarea {
    border: none;
    resize: vertical;
    width: 100%;
    padding: 10px;
    font-family: var(--font-family);
    outline: none;
}


/* --- EMPTY STATE --- */
.empty-state {
  background: white;
  border-radius: var(--radius-card);
  border: 2px dashed var(--border-light);
  padding: 60px 20px;
  text-align: center;
  margin-top: 2rem;
  color: var(--text-muted);
}
.empty-icon {
  margin: 0 auto 1.5rem;
  color: #ccdbe8;
  width: 64px;
  height: 64px;
}
.empty-icon svg { width: 100%; height: 100%; }
.empty-state h3 {
  color: var(--primary-blue);
  font-size: 18px;
  margin-bottom: 0.5rem;
}

/* --- FOOTER SUMMARY --- */
.summary-footer {
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  background: white;
  border-radius: var(--radius-pill);
  box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  padding: 15px 30px;
  z-index: 90;
  display: flex;
  gap: 30px;
  align-items: center;
  border: 1px solid var(--border-light);
}

.summary-stats {
  display: flex;
  gap: 20px;
  font-size: 13px;
  font-weight: 600;
}

.text-green { color: #16a34a; }
.text-orange { color: #ea580c; }
.version-text { color: #999; font-size: 11px; margin-left: auto; border-left: 1px solid #eee; padding-left: 20px; }

/* Responsive */
@media (max-width: 768px) {
  .autodoc-wrapper { padding: 15px; }
  .header-actions { width: 100%; justify-content: center; }
  .btn { width: 100%; justify-content: center; }
  
  .card-header { flex-direction: column; align-items: flex-start; gap: 15px; }
  .card-header-content { flex-direction: column; align-items: flex-start; width: 100%; }
  .card-number { display: none; }
  .card-actions { width: 100%; justify-content: space-between; margin-top: 10px; }
  
  .entry-box { min-width: 100%; }
  .entry-label { min-width: 100px; padding: 0 10px; font-size: 11px; }
}
